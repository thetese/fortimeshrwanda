# Google SMTP (Gmail / Google Workspace) configuration for /api/quote
#
# Setup instructions:
# 1. Enable 2-Step Verification on your Google Account (e.g. fortimeshrwanda@gmail.com).
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
#    (Select "Mail" or "Other" -> e.g. "Fortimesh Website").
# 3. Copy this file to .env.local for local development:
#      cp .env.example .env.local
# 4. In production (Vercel), add these same variables under:
#      Project Settings -> Environment Variables

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=fortimeshrwanda@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="FORTIMESH Website <fortimeshrwanda@gmail.com>"
QUOTE_INBOX_EMAIL=fortimeshrwanda@gmail.com

# Optional webhook URL to receive a JSON copy of each submitted quote
# QUOTE_WEBHOOK_URL=
